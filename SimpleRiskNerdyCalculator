function shuffledIndices(n){
  const arr = Array.from({length:n}, (_,i)=>i);
  for(let i=arr.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [arr[i],arr[j]]=[arr[j],arr[i]];
  }
  return arr;
}

/* ---------- ticker tapes ---------- */
function buildTicker(elId, count){
  const el = document.getElementById(elId);
  const idxs = shuffledIndices(QUOTES.length).slice(0,count);
  const html = idxs.map(i => `<span>${QUOTES[i]}</span>`).join('');
  el.innerHTML = html + html; // duplicate for seamless loop
}
buildTicker('ticker-top', 18);
buildTicker('ticker-bottom', 18);

/* ---------- rotating hero quote ---------- */
const order = shuffledIndices(QUOTES.length);
let qPos = 0;
const quoteTextEl = document.getElementById('quote-text');
const quoteIndexEl = document.getElementById('quote-index');

function showQuote(){
  const idx = order[qPos];
  quoteTextEl.textContent = "“" + QUOTES[idx] + "”";
  quoteIndexEl.textContent = "Q. " + String(idx+1).padStart(3,'0') + " / " + QUOTES.length;
}
function nextQuote(){
  quoteTextEl.classList.add('fade-out');
  setTimeout(()=>{
    qPos = (qPos+1) % order.length;
    showQuote();
    quoteTextEl.classList.remove('fade-out');
  }, 480);
}
showQuote();
let quoteTimer = setInterval(nextQuote, 5200);

