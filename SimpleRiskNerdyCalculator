<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RISK DESK — Defined-Risk Position Ledger</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0b0d10;
    --panel:#12151a;
    --panel-raised:#161a20;
    --line:#242a32;
    --line-soft:#1a1f26;
    --paper:#eae7dd;
    --muted:#868c96;
    --muted-dim:#565c66;
    --amber:#e8a33d;
    --amber-dim:#8a6626;
    --profit:#3ecf8e;
    --profit-dim:#1e4a37;
    --risk:#e5484d;
    --risk-dim:#4a2225;
    --display:'Space Grotesk', sans-serif;
    --mono:'JetBrains Mono', monospace;
    --body:'Inter', sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{-webkit-tap-highlight-color:transparent;}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:var(--body);
    min-height:100vh;
    overflow-x:hidden;
    background-image:
      linear-gradient(rgba(232,163,61,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232,163,61,0.025) 1px, transparent 1px);
    background-size:36px 36px;
  }
  ::selection{background:var(--amber);color:var(--ink);}

  /* ---------- SCREEN MANAGEMENT ---------- */
  .screen{display:none;min-height:100vh;}
  .screen.active{display:block;}

  /* ================= LANDING ================= */
  #screen-landing{
    display:flex;
    flex-direction:column;
    min-height:100vh;
    position:relative;
  }
  .ticker{
    border-bottom:1px solid var(--line);
    overflow:hidden;
    white-space:nowrap;
    padding:10px 0;
    background:var(--panel);
  }
  .ticker.bottom-line{border-bottom:none;border-top:1px solid var(--line);}
  .ticker-track{
    display:inline-block;
    white-space:nowrap;
    animation:ticker-scroll 55s linear infinite;
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:0.03em;
    color:var(--muted-dim);
  }
  .ticker.reverse .ticker-track{animation-direction:reverse;animation-duration:70s;}
  .ticker-track span{margin-right:44px;}
  .ticker-track span::before{content:"◆ ";color:var(--amber-dim);}
  @keyframes ticker-scroll{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }

  .landing-main{
    flex:1;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:48px 24px;
    position:relative;
  }
  .brand-mark{
    font-family:var(--mono);
    font-size:12px;
    letter-spacing:0.35em;
    color:var(--amber);
    text-transform:uppercase;
    margin-bottom:28px;
    opacity:0;
    animation:rise 0.7s ease forwards 0.1s;
  }
  .brand-mark::before{content:"01 — 02 — 03 — 04 — 05";display:block;font-size:10px;color:var(--muted-dim);letter-spacing:0.25em;margin-bottom:10px;}
  h1.title{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(40px, 8vw, 92px);
    line-height:0.98;
    letter-spacing:-0.02em;
    color:var(--paper);
    opacity:0;
    animation:rise 0.8s ease forwards 0.25s;
  }
  h1.title em{
    font-style:normal;
    color:var(--amber);
  }
  .subtitle{
    font-family:var(--body);
    font-size:15px;
    color:var(--muted);
    max-width:520px;
    margin:22px auto 0;
    line-height:1.6;
    opacity:0;
    animation:rise 0.8s ease forwards 0.4s;
  }

  .quote-box{
    margin-top:56px;
    max-width:640px;
    min-height:120px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    opacity:0;
    animation:rise 0.8s ease forwards 0.55s;
  }
  .quote-rule{
    width:34px;height:2px;background:var(--amber);margin-bottom:20px;
  }
  #quote-text{
    font-family:var(--display);
    font-size:clamp(18px, 2.6vw, 25px);
    font-weight:500;
    color:var(--paper);
    line-height:1.5;
    transition:opacity 0.5s ease, transform 0.5s ease;
  }
  #quote-index{
    font-family:var(--mono);
    font-size:11px;
    color:var(--muted-dim);
    margin-top:18px;
    letter-spacing:0.1em;
  }
  .fade-out{opacity:0 !important;transform:translateY(6px);}

  .enter-btn{
    margin-top:52px;
    background:transparent;
    border:1px solid var(--amber);
    color:var(--amber);
    font-family:var(--mono);
    font-size:13px;
    letter-spacing:0.15em;
    text-transform:uppercase;
    padding:16px 38px;
    cursor:pointer;
    position:relative;
    transition:all 0.25s ease;
    opacity:0;
    animation:rise 0.8s ease forwards 0.7s;
  }
  .enter-btn:hover{background:var(--amber);color:var(--ink);}
  .enter-btn:focus-visible{outline:2px solid var(--amber);outline-offset:4px;}

  @keyframes rise{
    from{opacity:0;transform:translateY(14px);}
    to{opacity:1;transform:translateY(0);}
  }

  @media (prefers-reduced-motion: reduce){
    .ticker-track{animation:none;}
    .brand-mark,h1.title,.subtitle,.quote-box,.enter-btn{animation:none;opacity:1;}
  }

  /* ================= CALCULATOR ================= */
  #screen-calc{padding-bottom:60px;}
  .calc-header{
    border-bottom:1px solid var(--line);
    padding:22px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:var(--panel);
    position:sticky;top:0;z-index:20;
  }
  .calc-header .brand{
    font-family:var(--mono);
    font-size:13px;
    letter-spacing:0.2em;
    color:var(--amber);
  }
  .back-btn{
    background:none;border:1px solid var(--line);color:var(--muted);
    font-family:var(--mono);font-size:11px;letter-spacing:0.08em;
    padding:9px 16px;cursor:pointer;transition:all 0.2s ease;text-transform:uppercase;
  }
  .back-btn:hover{border-color:var(--amber);color:var(--amber);}

  .calc-wrap{
    max-width:1180px;
    margin:0 auto;
    padding:40px 24px 0;
    display:grid;
    grid-template-columns:360px 1fr;
    gap:28px;
    align-items:start;
  }
  @media (max-width:880px){
    .calc-wrap{grid-template-columns:1fr;}
  }

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
  }
  .panel-head{
    padding:16px 20px;
    border-bottom:1px solid var(--line);
    display:flex;align-items:center;justify-content:space-between;
  }
  .panel-head .eyebrow{
    font-family:var(--mono);font-size:11px;letter-spacing:0.14em;
    color:var(--muted-dim);text-transform:uppercase;
  }
  .panel-body{padding:22px 20px;}

  .field{margin-bottom:20px;}
  .field:last-child{margin-bottom:0;}
  .field label{
    display:block;font-family:var(--mono);font-size:11px;
    letter-spacing:0.08em;color:var(--muted);text-transform:uppercase;margin-bottom:9px;
  }
  .field-hint{font-family:var(--body);font-size:11.5px;color:var(--muted-dim);margin-top:7px;line-height:1.4;}
  .input-row{display:flex;align-items:stretch;border:1px solid var(--line);background:var(--ink);}
  .input-row .prefix{
    display:flex;align-items:center;padding:0 12px;
    font-family:var(--mono);font-size:13px;color:var(--muted-dim);
    border-right:1px solid var(--line);background:var(--line-soft);
  }
  .input-row input{
    flex:1;background:transparent;border:none;color:var(--paper);
    font-family:var(--mono);font-size:16px;padding:13px 12px;width:100%;min-width:0;
  }
  .input-row input:focus{outline:none;background:rgba(232,163,61,0.05);}
  .input-row:focus-within{border-color:var(--amber);}

  .toggle-group{display:flex;border:1px solid var(--line);}
  .toggle-group button{
    flex:1;background:var(--ink);border:none;color:var(--muted);
    font-family:var(--mono);font-size:11.5px;letter-spacing:0.06em;
    padding:11px 8px;cursor:pointer;text-transform:uppercase;
    border-right:1px solid var(--line);transition:all 0.2s ease;
  }
  .toggle-group button:last-child{border-right:none;}
  .toggle-group button.on{background:var(--amber);color:var(--ink);font-weight:600;}
  .toggle-group button:not(.on):hover{color:var(--paper);}

  .direction-flag{
    margin-top:18px;padding:12px 14px;font-family:var(--mono);font-size:12px;
    letter-spacing:0.05em;border-left:2px solid var(--amber);background:var(--line-soft);color:var(--muted);
  }
  .direction-flag b{color:var(--paper);}
  .direction-flag.long{border-color:var(--profit);}
  .direction-flag.short{border-color:var(--risk);}

  /* results side */
  .stat-strip{
    display:grid;grid-template-columns:repeat(4,1fr);
    border:1px solid var(--line);margin-bottom:22px;
  }
  .stat{
    padding:18px 16px;border-right:1px solid var(--line);
  }
  .stat:last-child{border-right:none;}
  .stat .k{font-family:var(--mono);font-size:10.5px;letter-spacing:0.1em;color:var(--muted-dim);text-transform:uppercase;margin-bottom:9px;}
  .stat .v{font-family:var(--mono);font-size:22px;font-weight:600;color:var(--paper);}
  .stat .v.amber{color:var(--amber);}
  .stat .v.profit{color:var(--profit);}
  .stat .v.risk{color:var(--risk);}
  .stat .sub{font-family:var(--body);font-size:11px;color:var(--muted-dim);margin-top:5px;}
  @media (max-width:640px){.stat-strip{grid-template-columns:repeat(2,1fr);}
    .stat:nth-child(2){border-right:none;}
    .stat:nth-child(3),.stat:nth-child(4){border-top:1px solid var(--line);}}

  /* R-ladder — signature element */
  .ladder-wrap{padding:26px 20px 20px;}
  .ladder-title{font-family:var(--mono);font-size:11px;letter-spacing:0.12em;color:var(--muted-dim);text-transform:uppercase;margin-bottom:22px;}
  .ladder{position:relative;height:6px;background:var(--line);margin:0 6px 10px;border-radius:2px;}
  .ladder-fill-risk{position:absolute;top:0;bottom:0;background:var(--risk-dim);border-radius:2px;}
  .ladder-fill-reward{position:absolute;top:0;bottom:0;background:var(--profit-dim);border-radius:2px;}
  .ladder-tick{
    position:absolute;top:-5px;width:2px;height:16px;background:var(--muted-dim);
  }
  .ladder-tick.entry{background:var(--paper);width:2px;}
  .ladder-tick.sl{background:var(--risk);}
  .ladder-tick.tp{background:var(--profit);}
  .ladder-labels{position:relative;height:56px;margin:0 6px;}
  .ladder-label{
    position:absolute;transform:translateX(-50%);text-align:center;
    font-family:var(--mono);font-size:10.5px;color:var(--muted);white-space:nowrap;
  }
  .ladder-label .lp{font-weight:700;font-size:12px;display:block;margin-bottom:3px;}
  .ladder-label.sl .lp{color:var(--risk);}
  .ladder-label.entry .lp{color:var(--paper);}
  .ladder-label.tp .lp{color:var(--profit);}
  .ladder-label .lr{font-size:9.5px;color:var(--muted-dim);}

  table.tp-table{width:100%;border-collapse:collapse;margin-top:6px;}
  table.tp-table th{
    text-align:left;font-family:var(--mono);font-size:10.5px;letter-spacing:0.08em;
    color:var(--muted-dim);text-transform:uppercase;padding:12px 14px;border-bottom:1px solid var(--line);
  }
  table.tp-table td{
    font-family:var(--mono);font-size:14px;padding:13px 14px;border-bottom:1px solid var(--line-soft);color:var(--paper);
  }
  table.tp-table tr:last-child td{border-bottom:none;}
  table.tp-table td.r-badge{color:var(--profit);font-weight:600;}
  table.tp-table td.tp-price{font-weight:700;font-size:15px;}
  table.tp-table td.dim{color:var(--muted);}
  table.tp-table tr:hover td{background:rgba(232,163,61,0.03);}

  .footnote{
    font-family:var(--body);font-size:11.5px;color:var(--muted-dim);
    padding:16px 20px 0;line-height:1.6;
  }

  .quote-strip-calc{
    max-width:1180px;margin:36px auto 0;padding:0 24px;
    font-family:var(--display);font-size:14px;color:var(--muted-dim);
    text-align:center;font-style:normal;
  }
  .quote-strip-calc span{color:var(--amber);}
</style>
</head>
<body>

<!-- ============ LANDING SCREEN ============ -->
<section id="screen-landing" class="screen active">
  <div class="ticker">
    <div class="ticker-track" id="ticker-top"></div>
  </div>

  <div class="landing-main">
    <div class="brand-mark">Position Sizing &nbsp;·&nbsp; Defined Risk &nbsp;·&nbsp; Personal Desk</div>
    <h1 class="title">RISK<em>DESK</em></h1>
    <p class="subtitle">You don't control where price goes. You control how much you lose finding out. Size the trade before you take it.</p>

    <div class="quote-box">
      <div class="quote-rule"></div>
      <div id="quote-text">Loading...</div>
      <div id="quote-index">Q. 001 / 100</div>
    </div>

    <button class="enter-btn" id="enter-btn">Enter the Desk →</button>
  </div>

  <div class="ticker bottom-line reverse">
    <div class="ticker-track" id="ticker-bottom"></div>
  </div>
</section>

<!-- ============ CALCULATOR SCREEN ============ -->
<section id="screen-calc" class="screen">
  <div class="calc-header">
    <div class="brand">RISK<span style="color:var(--paper)">DESK</span></div>
    <button class="back-btn" id="back-btn">← Welcome</button>
  </div>

  <div class="calc-wrap">
    <!-- INPUT PANEL -->
    <div class="panel">
      <div class="panel-head"><span class="eyebrow">Trade Inputs</span></div>
      <div class="panel-body">

        <div class="field">
          <label for="capital">Total Capital</label>
          <div class="input-row">
            <span class="prefix">₹</span>
            <input type="number" id="capital" value="50000" inputmode="decimal" step="any">
          </div>
        </div>

        <div class="field">
          <label>Risk Input Mode</label>
          <div class="toggle-group" id="risk-mode-toggle">
            <button class="on" data-mode="amount">₹ Amount</button>
            <button data-mode="percent">% of Capital</button>
          </div>
        </div>

        <div class="field" id="risk-amount-field">
          <label for="risk-amount">Risk Amount</label>
          <div class="input-row">
            <span class="prefix">₹</span>
            <input type="number" id="risk-amount" value="500" inputmode="decimal" step="any">
          </div>
          <div class="field-hint" id="risk-pct-hint"></div>
        </div>

        <div class="field" id="risk-percent-field" style="display:none;">
          <label for="risk-percent">Risk %</label>
          <div class="input-row">
            <input type="number" id="risk-percent" value="1" inputmode="decimal" step="any">
            <span class="prefix" style="border-right:none;border-left:1px solid var(--line);">%</span>
          </div>
          <div class="field-hint" id="risk-amt-hint"></div>
        </div>

        <div class="field">
          <label for="entry">Entry Price</label>
          <div class="input-row">
            <span class="prefix">₹</span>
            <input type="number" id="entry" value="173.89" inputmode="decimal" step="any">
          </div>
        </div>

        <div class="field">
          <label for="sl">Stop Loss Price</label>
          <div class="input-row">
            <span class="prefix">₹</span>
            <input type="number" id="sl" value="171.50" inputmode="decimal" step="any">
          </div>
        </div>

        <div class="field">
          <label for="lotsize">Lot Size <span style="color:var(--muted-dim);text-transform:none;">(optional, for F&O)</span></label>
          <div class="input-row">
            <input type="number" id="lotsize" placeholder="e.g. 1500 — leave blank for equity" inputmode="numeric" step="1">
          </div>
        </div>

        <div class="direction-flag" id="direction-flag">— enter entry &amp; SL —</div>
      </div>
    </div>

    <!-- RESULTS -->
    <div>
      <div class="stat-strip">
        <div class="stat">
          <div class="k">Quantity</div>
          <div class="v amber" id="out-qty">—</div>
          <div class="sub" id="out-qty-sub">&nbsp;</div>
        </div>
        <div class="stat">
          <div class="k">Risk / Share</div>
          <div class="v" id="out-perunit">—</div>
        </div>
        <div class="stat">
          <div class="k">Actual Risk</div>
          <div class="v risk" id="out-actual-risk">—</div>
          <div class="sub" id="out-risk-pct">&nbsp;</div>
        </div>
        <div class="stat">
          <div class="k">Capital Deployed</div>
          <div class="v" id="out-deployed">—</div>
          <div class="sub" id="out-deployed-pct">&nbsp;</div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head"><span class="eyebrow">Risk / Reward Ladder</span></div>
        <div class="ladder-wrap">
          <div class="ladder-title">Stop → Entry → Targets, scaled by distance</div>
          <div class="ladder" id="ladder-track">
            <div class="ladder-fill-risk" id="fill-risk"></div>
            <div class="ladder-fill-reward" id="fill-reward"></div>
          </div>
          <div class="ladder-labels" id="ladder-labels"></div>
        </div>

        <table class="tp-table">
          <thead>
            <tr>
              <th>Level</th>
              <th>R-Multiple</th>
              <th>Target Price</th>
              <th>Gain / Share</th>
              <th>Profit at Qty</th>
            </tr>
          </thead>
          <tbody id="tp-table-body"></tbody>
        </table>

        <p class="footnote">Targets are set at 1R–5R (multiples of your per-share risk) from entry, in the direction of your trade. Quantity is floored to a whole share/unit — and to whole lots if a lot size is set — so actual risk may land slightly under your risk input, never over.</p>
      </div>
    </div>
  </div>

  <div class="quote-strip-calc" id="calc-quote">&nbsp;</div>
</section>

<script>
