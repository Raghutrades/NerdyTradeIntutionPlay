/* ============ CALCULATOR LOGIC ============ */
const fmt = new Intl.NumberFormat('en-IN', {maximumFractionDigits:2});
const fmtInt = new Intl.NumberFormat('en-IN');

const capitalEl = document.getElementById('capital');
const riskAmountEl = document.getElementById('risk-amount');
const riskPercentEl = document.getElementById('risk-percent');
const entryEl = document.getElementById('entry');
const slEl = document.getElementById('sl');
const lotsizeEl = document.getElementById('lotsize');

let riskMode = 'amount'; // 'amount' | 'percent'
const modeButtons = document.querySelectorAll('#risk-mode-toggle button');
modeButtons.forEach(btn=>{
  btn.addEventListener('click', ()=>{
    modeButtons.forEach(b=>b.classList.remove('on'));
    btn.classList.add('on');
    riskMode = btn.dataset.mode;
    document.getElementById('risk-amount-field').style.display = riskMode==='amount' ? 'block':'none';
    document.getElementById('risk-percent-field').style.display = riskMode==='percent' ? 'block':'none';
    compute();
  });
});

[capitalEl, riskAmountEl, riskPercentEl, entryEl, slEl, lotsizeEl].forEach(el=>{
  el.addEventListener('input', compute);
});

function rupee(n){
  if(!isFinite(n)) return '—';
  return '₹' + fmt.format(n);
}

function compute(){
  const capital = parseFloat(capitalEl.value) || 0;
  const entry = parseFloat(entryEl.value);
  const sl = parseFloat(slEl.value);
  const lotSize = parseInt(lotsizeEl.value);
  const hasLot = !!lotSize && lotSize > 0;

  let riskAmount;
  if(riskMode === 'amount'){
    riskAmount = parseFloat(riskAmountEl.value) || 0;
    document.getElementById('risk-pct-hint').textContent = capital>0
      ? '≈ ' + (riskAmount/capital*100).toFixed(2) + '% of capital'
      : '';
  } else {
    const pct = parseFloat(riskPercentEl.value) || 0;
    riskAmount = capital * pct/100;
    document.getElementById('risk-amt-hint').textContent = '= ' + rupee(riskAmount);
  }

  const directionFlag = document.getElementById('direction-flag');

  if(!entry || !sl || entry === sl || riskAmount<=0){
    directionFlag.textContent = '— enter entry & SL —';
    directionFlag.className = 'direction-flag';
    resetOutputs();
    return;
  }

  const perUnitRisk = Math.abs(entry - sl);
  const isLong = entry > sl;

  directionFlag.innerHTML = isLong
    ? '<b>LONG</b> — target above entry, stop below'
    : '<b>SHORT</b> — target below entry, stop above';
  directionFlag.className = 'direction-flag ' + (isLong ? 'long':'short');

  let qty = Math.floor(riskAmount / perUnitRisk);
  let lots = 0;
  if(hasLot){
    lots = Math.floor(qty / lotSize);
    qty = lots * lotSize;
  }

  const actualRisk = qty * perUnitRisk;
  const deployed = qty * entry;

  document.getElementById('out-qty').textContent = qty>0 ? fmtInt.format(qty) : '0';
  document.getElementById('out-qty-sub').textContent = hasLot ? (lots + ' lot' + (lots===1?'':'s') + ' × ' + lotSize) : (qty>0 ? 'shares/units' : 'risk too small for 1 unit');
  document.getElementById('out-perunit').textContent = rupee(perUnitRisk);
  document.getElementById('out-actual-risk').textContent = rupee(actualRisk);
  document.getElementById('out-risk-pct').textContent = capital>0 ? (actualRisk/capital*100).toFixed(2) + '% of capital' : '';
  document.getElementById('out-deployed').textContent = rupee(deployed);
  document.getElementById('out-deployed-pct').textContent = capital>0 ? (deployed/capital*100).toFixed(1) + '% of capital' : '';

  buildLadderAndTable(entry, sl, perUnitRisk, isLong, qty);
}

function resetOutputs(){
  ['out-qty','out-perunit','out-actual-risk','out-deployed'].forEach(id=>document.getElementById(id).textContent='—');
  ['out-qty-sub','out-risk-pct','out-deployed-pct'].forEach(id=>document.getElementById(id).textContent='\u00A0');
  document.getElementById('ladder-labels').innerHTML = '';
  document.getElementById('fill-risk').style.width = '0';
  document.getElementById('fill-reward').style.width = '0';
  document.getElementById('tp-table-body').innerHTML = '';
}

function buildLadderAndTable(entry, sl, perUnitRisk, isLong, qty){
  const levels = [1,2,3,4,5];
  const targets = levels.map(r => isLong ? entry + r*perUnitRisk : entry - r*perUnitRisk);

  // table
  const tbody = document.getElementById('tp-table-body');
  tbody.innerHTML = levels.map((r,i)=>{
    const price = targets[i];
    const gainPerShare = r * perUnitRisk;
    const profit = gainPerShare * qty;
    return `<tr>
      <td>TP${r}</td>
      <td class="r-badge">${r}R</td>
      <td class="tp-price">${rupee(price)}</td>
      <td class="dim">${rupee(gainPerShare)}</td>
      <td>${rupee(profit)}</td>
    </tr>`;
  }).join('');

  // ladder — map SL ... entry ... TP5 to 0-100%
  const low = isLong ? sl : targets[4];
  const high = isLong ? targets[4] : sl;
  const span = high - low;

  function pct(v){ return span>0 ? ((v-low)/span*100) : 50; }

  const slPct = pct(sl);
  const entryPct = pct(entry);

  const fillRisk = document.getElementById('fill-risk');
  const fillReward = document.getElementById('fill-reward');
  const riskLeft = Math.min(slPct, entryPct);
  const riskWidth = Math.abs(entryPct - slPct);
  fillRisk.style.left = riskLeft + '%';
  fillRisk.style.width = riskWidth + '%';

  const rewardLeft = isLong ? entryPct : pct(targets[4]);
  const rewardWidth = Math.abs(pct(targets[4]) - entryPct);
  fillReward.style.left = rewardLeft + '%';
  fillReward.style.width = rewardWidth + '%';

  const labelsEl = document.getElementById('ladder-labels');
  let marks = [
    {p: slPct, price: sl, tag:'SL', cls:'sl'},
    {p: entryPct, price: entry, tag:'ENTRY', cls:'entry'},
  ];
  levels.forEach((r,i)=> marks.push({p: pct(targets[i]), price: targets[i], tag:'TP'+r, cls:'tp', r}));

  labelsEl.innerHTML = marks.map(m => `
    <div class="ladder-label ${m.cls}" style="left:${m.p}%;">
      <span class="lp">${m.tag}</span>
      ${rupee(m.price)}<br>
      ${m.r ? '<span class="lr">'+m.r+'R</span>' : (m.cls==='entry' ? '<span class="lr">0R</span>' : '<span class="lr">stop</span>')}
    </div>
  `).join('');

  // reposition tick marks visually via same left offsets on the track
  const track = document.getElementById('ladder-track');
  // remove old ticks
  track.querySelectorAll('.ladder-tick').forEach(t=>t.remove());
  marks.forEach(m=>{
    const tick = document.createElement('div');
    tick.className = 'ladder-tick ' + m.cls;
    tick.style.left = m.p + '%';
    track.appendChild(tick);
  });
}

compute();
</script>
